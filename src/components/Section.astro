---
// Numbered section on the page grid: label column on the left, content on the right.
interface Props {
  id: string;
  numero: string;
  titulo: string;
}

const { id, numero, titulo } = Astro.props;
const headingId = `${id}-titulo`;
---

<section class="section" id={id} aria-labelledby={headingId}>
  <header class="section__head">
    <span class="label" aria-hidden="true">{numero}</span>
    <h2 id={headingId} class="section__title">{titulo}</h2>
  </header>
  <div class="section__body">
    <slot />
  </div>
</section>

<style>
  .section {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-12);
    border-top: var(--line);
  }

  .section__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
  }

  .section__title {
    font-size: var(--text-lg);
    font-weight: 500;
  }

  @media (min-width: 64rem) {
    .section {
      grid-template-columns: 1fr 3fr;
      gap: var(--space-8);
      padding-block: var(--space-16);
    }

    .section__head {
      flex-direction: column;
      gap: var(--space-2);
      position: sticky;
      top: var(--space-8);
      align-self: start;
    }
  }
</style>
