---
import Base from '../layouts/Base.astro';
import Monogram from '../components/Monogram.astro';
import { persona } from '../data/perfil';

const inicio = import.meta.env.BASE_URL;
---

<Base title={`Página no encontrada — ${persona.nombre}`} description={persona.descripcion} noindex>
  <main id="contenido" class="not-found">
    <Monogram size={28} title={persona.nombre} />
    <div class="not-found__body">
      <p class="label">Error 404</p>
      <h1 class="not-found__title">Esta página no existe.</h1>
      <p class="not-found__text">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
      <a href={inicio}>Volver al inicio</a>
    </div>
  </main>
</Base>

<style>
  .not-found {
    display: grid;
    align-content: space-between;
    gap: var(--space-16);
    min-height: 100vh;
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-6) var(--page-gutter) var(--space-24);
  }

  .not-found__body {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .not-found__title {
    font-size: var(--text-display);
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
  }

  .not-found__text {
    max-width: 40ch;
    color: var(--color-text-muted);
  }
</style>
